{
  "name": "themis-ds",
  "version": "0.1.0",
  "description": "Themis \u2014 a parametric, accessible React design system built on React Aria Components and StyleX.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/themis.css",
    "./manifest.json": "./dist/themis-manifest.json",
    "./theme.schema.json": "./dist/theme.schema.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "manifest": "tsx scripts/build-manifest.ts",
    "fonts": "tsx scripts/build-google-fonts.ts",
    "storybook": "npm run tokens && npm run manifest && storybook dev -p 6006",
    "build-storybook": "npm run tokens && npm run manifest && storybook build",
    "build": "npm run tokens && npm run contrast -- --strict && npm run manifest && vite build && tsc -p tsconfig.build.json && cp public/themis-manifest.json src/theme/theme.schema.json dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contrast": "tsx scripts/check-contrast.ts",
    "config": "vite --config apps/config/vite.config.ts",
    "config:build": "vite build --config apps/config/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "lucide": "1.66.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@figma/code-connect": "2.1.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
