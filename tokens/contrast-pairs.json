{
  "$description": "Every text (or icon) colour the components put on a surface, at rest and on hover. `npm run contrast` rates each pair in every colour theme. Add a pair whenever a component puts text on a new surface or tint. `overlay` is a see-through colorTheme token composited over `surface`, the way the browser draws it. Subtle buttons are only rated on the surfaces their guidelines allow (Button / IconButton docs). `minimum` overrides the default for a pair (3 for icons); `level: advisory` pairs (disabled text, which WCAG exempts) are reported but never fail.",
  "minimum": 4.5,
  "pairs": [
    {
      "id": "text",
      "text": "colorTheme/color.text",
      "surface": "colorTheme/color.background",
      "usedBy": [
        "Everything"
      ]
    },
    {
      "id": "text-brand",
      "text": "colorTheme/color.text-brand",
      "surface": "colorTheme/color.background",
      "usedBy": [
        "Button/IconButton brand outline and subtle",
        "ToggleButton off",
        "SegmentedControl",
        "Avatar outline",
        "Chip brand",
        "Toast brand"
      ]
    },
    {
      "id": "error",
      "text": "colorTheme/color.state.error",
      "surface": "colorTheme/color.background",
      "usedBy": [
        "Button/IconButton danger outline and subtle",
        "Chip danger",
        "Toast danger",
        "Error messages",
        "ActionMenu danger item"
      ]
    },
    {
      "id": "warning",
